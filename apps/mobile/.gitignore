# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Native build artifacts (keep ios/ source tracked for EAS + custom native modules)
/ios/Pods/
/ios/build/
/ios/.xcode.env.local
/ios/DerivedData/
/android/build/
/android/.gradle/
/android/app/build/

# vendor-shared must be committed for EAS builds (self-contained, no workspace symlinks)
!vendor-shared/
!vendor-shared/**
